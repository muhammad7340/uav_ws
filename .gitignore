# =============================================================================
#  uav_ws — git ignore rules
#  Rule of thumb: commit source, configs, URDF/worlds/meshes and docs.
#  Never commit build outputs, virtualenvs or model weights
#  (weights are restored with scripts/download_models.sh).
# =============================================================================

# ---- colcon / ament build outputs -------------------------------------------
build/
install/
log/

# ---- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- Virtual environments ----------------------------------------------------
venv/
.venv/
*-venv/

# ---- Model weights (downloaded, never committed) -----------------------------
*.pt
*.pth
*.pt.zip
*.onnx
*.safetensors
*.ckpt
*.engine
*.ts
*.tflite

# OpenVINO IRs for GroundingDINO / EfficientSAM / BLIP (Google Drive zip)
**/modules/openvino_irs/*.xml
**/modules/openvino_irs/*.bin

# SmolVLM OpenVINO exports: keep only scripts and test images
tools/smolvlm/*/*
!tools/smolvlm/*/*.py
!tools/smolvlm/*/*.png
!tools/smolvlm/*/*.jpg

# OpenVINO compiled-model cache
ov_cache/

# ---- Runtime / generated output ----------------------------------------------
*.bag
*.db3
*.mcap
rosbag2_*/
frames_*.gv
frames_*.pdf
*.zip

# ---- Jupyter -----------------------------------------------------------------
.ipynb_checkpoints/

# ---- IDE / OS ----------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store

# ---- FloodScout (src/flood_vlm) ------------------------------------------
# GGUF weights live in ~/models/qwen35 (scripts/setup_vlm.sh), never in the repo
*.gguf
# mission runs and generated datasets; results/ is committed
runs/
data/
# generated worlds: keep only the demo seed
src/drone_basic/worlds/flood_town_*
!src/drone_basic/worlds/flood_town_7.sdf
!src/drone_basic/worlds/flood_town_7.gt.json
